# 性能压测端点配置
# 格式：ENDPOINT_<序号>_<方法>_<名称>=<路径>
# 所有端点基于 GATEWAY_BASE_URL（默认 http://localhost:8080）

# ===== 无需认证 =====
ENDPOINT_01_GET_health=/health

# ===== User 服务 =====
ENDPOINT_02_POST_user_login=/api/v1/user/login
ENDPOINT_03_GET_user_me=/api/v1/user/me
ENDPOINT_04_GET_schools=/api/v1/schools

# ===== Content 服务（读操作为主）=====
ENDPOINT_05_GET_content_posts=/api/v1/content/posts
ENDPOINT_06_GET_content_post_detail=/api/v1/content/posts/1
ENDPOINT_07_POST_content_search=/api/v1/content/search
ENDPOINT_08_GET_content_comments=/api/v1/content/posts/1/comments

# ===== Task 服务 =====
ENDPOINT_09_GET_tasks=/api/v1/tasks
ENDPOINT_10_GET_task_detail=/api/v1/tasks/1

# ===== Message 服务 =====
ENDPOINT_11_GET_notifications=/api/v1/notifications
ENDPOINT_12_GET_unread_count=/api/v1/notifications/unread-count

# ===== File 服务 =====
ENDPOINT_13_GET_file_meta=/api/v1/files/1
